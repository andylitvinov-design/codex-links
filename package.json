{
  "name": "codex-links",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public --project-name codex-links",
    "cloud:sync": "bash scripts/cloud-github-sync.sh",
    "reports:daily": "node scripts/daily-dashboard-reports.mjs",
    "save:dev": "cd codex-save && wrangler pages dev public",
    "save:deploy": "cd codex-save && wrangler pages deploy public --project-name codex-save",
    "kv:seed": "node scripts/seed-demo.mjs",
    "cloud:check": "node scripts/check-cloud-setup.mjs",
    "check:openclaw": "bash scripts/check-openclaw.sh",
    "probe:openclaw": "bash scripts/probe-openclaw-run.sh",
    "setup:openclaw:telegram": "node scripts/openclaw-telegram-setup.mjs",
    "setup:openclaw:telegram:anywhere": "node scripts/openclaw-telegram-anywhere.mjs",
    "doctor:openclaw:telegram": "node scripts/openclaw-telegram-doctor.mjs",
    "gateway:openclaw:telegram": "node scripts/openclaw-telegram-gateway.mjs",
    "install:openclaw:telegram-gateway": "node scripts/openclaw-telegram-launchd.mjs install",
    "start:openclaw:telegram-gateway": "node scripts/openclaw-telegram-launchd.mjs start",
    "stop:openclaw:telegram-gateway": "node scripts/openclaw-telegram-launchd.mjs stop",
    "status:openclaw:telegram-gateway": "node scripts/openclaw-telegram-launchd.mjs status",
    "activate:openclaw:telegram-gateway": "node scripts/openclaw-telegram-launchd.mjs activate",
    "pairing:openclaw:telegram": "openclaw pairing list telegram --json",
    "feedback:verify": "node scripts/openclaw-feedback-loop.mjs",

    "cloud:smoke": "node scripts/smoke-cloud-delivery.mjs",
    "cloud:photo-smoke": "node scripts/smoke-cloud-photo-delivery.mjs",
    "cloud:guardian": "node scripts/run-cloud-guardian.mjs",
    "bridge:smoke": "node scripts/smoke-bridge-delivery.mjs",
    "bridge:photo-smoke": "node scripts/smoke-bridge-photo-delivery.mjs",
    "claude:smoke": "node scripts/smoke-claude-delivery.mjs",
    "claude:photo-smoke": "node scripts/smoke-claude-photo-delivery.mjs",
    "smoke:delivery": "node scripts/smoke-delivery.mjs",
    "claude:bridge": "zsh scripts/run-claude-bridge.sh",
    "maintenance:run": "node scripts/run-delivery-maintenance.mjs",
    "cloud:install-secrets": "zsh scripts/install-pages-secrets.sh",
    "cloud:save-config": "node scripts/save-cloud-config.mjs",
    "cloud:sync-repos": "node scripts/sync-cloud-repos.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "rollback:prepare": "node scripts/revert-last-good.mjs"

LINKS_WRITE_TOKEN=replace-with-a-long-random-token
ADMIN_TOKEN=replace-with-a-long-random-admin-token
COMMAND_DISPATCH_MODE=cloud-via-slack
# Optional direct OpenAI API route only. cloud-via-slack does not require it.
OPENAI_API_KEY=
CLOUD_BRIDGE_BASE_URL=http://127.0.0.1:8788
CLOUD_BRIDGE_SHARED_SECRET=replace-with-the-same-secret-used-on-the-trusted-machine
CLOUD_BRIDGE_LABEL=Trusted Codex Cloud
CLOUD_BRIDGE_REQUEST_TIMEOUT_MS=20000
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GA4_DEBUG_MODE=0
# Optional legacy-only Slack config:
SLACK_BOT_TOKEN=xoxb-replace-me
# Optional user token for OpenAI Codex Slack dispatch. When set, outgoing
# @Codex messages and photo uploads use this token instead of the sender bot.
SLACK_CODEX_DISPATCH_TOKEN=xoxp-or-xoxc-replace-me
SLACK_SIGNING_SECRET=replace-me
SLACK_CODEX_CHANNEL_ID=C0123456789
SLACK_CODEX_USER_ID=U0123456789
SLACK_CODEX_MENTION=@Codex
